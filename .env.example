# Example .env file for Tienda Suplementos
# Copy this file to .env and fill real values before running locally or in Docker.

# JDBC URL (example Supabase format). Replace host, port, dbname and parameters as needed.
DB_URL=jdbc:postgresql://db.xxx.supabase.co:5432/tienda_suplementos?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# Spring profile to use
SPRING_PROFILES_ACTIVE=production

# Optional: Port (Render will inject PORT automatically)
# PORT=8080

# Stripe keys - DO NOT COMMIT real production keys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# CORS allowed origins (comma separated). Use your frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JVM options (optional)
JAVA_OPTS=-Xmx512m -Xms256m

# Notes:
# - Save this file as `.env` (same folder as your project root) and run the container using:
#   docker run --rm --env-file .env -p 8080:8080 tienda-suplementos:local
# - Or provide individual env vars on the docker run command line.
# - For production deploys (Render), configure these variables in the Render dashboard, not in a file checked into git.
